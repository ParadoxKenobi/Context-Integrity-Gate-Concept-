class Config:
    # --- Storage (audit log) ---
    AUDIT_FILE = "cig_audit.jsonl"
    ARCHIVE_DIR = "archive"
    MAX_AUDIT_FILE_SIZE = 1_500_000  # bytes (~1.5MB) before rotate
    LOG_FILE = "cig.log"

    # --- Locking ---
    LOCK_STALE_SECONDS = 30.0
    LOCK_ACQUIRE_TIMEOUT = 10.0
    LOCK_POLL_INTERVAL = 0.12

    # --- Atomic write retries ---
    WRITE_ATTEMPTS = 3
    WRITE_BASE_WAIT = 0.08

    # --- Safety limits ---
    MAX_DEPTH = 12
    MAX_KEYS_PER_OBJECT = 250
    MAX_LIST_LENGTH = 2_000
    MAX_STRING_LENGTH = 20_000
    MAX_TOTAL_NODES = 25_000  # total nodes visited in structure
    MAX_BYTES_ESTIMATE = 2_000_000  # approximate size guardrail for payload

    # --- Canonicalization ---
    NORMALIZE_UNICODE = True
    COLLAPSE_WHITESPACE = True
    STRIP_STRINGS = True

    # --- Policy defaults ---
    BLOCKED_CONTEXT_TYPES = {"credential_dump", "malware_config"}
    SECRET_KEY_NAME_HINTS = {
        "password", "passwd", "pass", "secret", "api_key", "apikey",
        "token", "auth", "authorization", "bearer", "private_key", "ssh_key",
    }

    # If a key name matches these patterns, we reject (you can change to redact+flag if you want).
    SECRET_KEY_PATTERNS = [
        re.compile(r".*\b(password|passwd|api[_-]?key|secret|token|private[_-]?key)\b.*", re.IGNORECASE),
        re.compile(r"^authorization$", re.IGNORECASE),
    ]

    # If a value matches these patterns, we FLAG (not auto-reject) by default.
    # (Example patterns: looks like a long token or key. Tune for your needs.)
    SECRET_VALUE_PATTERNS = [
        re.compile(r"^sk-[A-Za-z0-9]{20,}$"),          # looks like a secret token
        re.compile(r"^[A-Za-z0-9_\-]{40,}$"),          # long opaque token-ish
        re.compile(r"-----BEGIN [A-Z ]+PRIVATE KEY-----"),  # PEM header
    ]


