def _format_issues(issues: Tuple[GateIssue, ...]) -> str:
    if not issues:
        return "No issues ✅"
    lines = []
    for i in issues:
        lines.append(f"- [{i.severity.upper()}] {i.code} at {i.path}: {i.message}")
    return "\n".join(lines)

def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Context Integrity Gate (CIG)")
    p.add_argument("--input-json", help="JSON object as a string", default=None)
    p.add_argument("--input-file", help="Path to JSON file", default=None)
    p.add_argument("--source", help="Source: user|file|api|cache|other", default="other")
    p.add_argument("--no-audit", help="Do not persist audit log", action="store_true")
    p.add_argument("--print-canonical", help="Print canonical context", action="store_true")
    p.add_argument("--run-tests", help="Run unit tests and exit", action="store_true")
    return p

def _parse_source(s: str) -> SourceType:
    s = (s or "other").strip().lower()
    mapping = {
        "user": SourceType.USER,
        "file": SourceType.FILE,
        "api": SourceType.API,
        "cache": SourceType.CACHE,
        "other": SourceType.OTHER,
    }
    return mapping.get(s, SourceType.OTHER)

def main_cli(argv: Optional[List[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)

    if args.run_tests:
        suite = unittest.defaultTestLoader.loadTestsFromModule(sys.modules[__name__])
        result = unittest.TextTestRunner(verbosity=2).run(suite)
        return 0 if result.wasSuccessful() else 1

    if not args.input_json and not args.input_file:
        print("❌ Provide --input-json or --input-file")
        return 2

    raw: Union[str, Dict[str, Any]]
    if args.input_file:
        raw = args.input_file
    else:
        raw = args.input_json or ""

    gate = ContextIntegrityGate()
    result = gate.process(
        raw,
        source=_parse_source(args.source),
        persist_audit=not args.no_audit,
    )

    print("\n" + "═" * 60)
    print(f"CIG DECISION: {result.decision.name} 🧱")
    print(f"Source: {result.source}")
    print(f"Received: {result.received_at}")
    print(f"Fingerprint (sha256): {result.fingerprint_sha256}")
    print("Issues:")
    print(_format_issues(result.issues))

    if args.print_canonical:
        print("\nCanonical Context:")
        print(json.dumps(result.canonical_context, indent=2, ensure_ascii=False, sort_keys=True))

    print("═" * 60 + "\n")
    return 0


