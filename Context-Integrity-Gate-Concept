@dataclass(frozen=True, slots=True)
class GateIssue:
    code: str
    message: str
    path: str = ""  # JSON pointer-ish path, e.g. "/subject/id"
    severity: str = "error"  # error | warn | info

@dataclass(frozen=True, slots=True)
class GateResult:
    decision: Decision
    issues: Tuple[GateIssue, ...]
    canonical_context: Dict[str, Any]
    fingerprint_sha256: str
    received_at: str
    source: str

    def to_audit_event(self) -> Dict[str, Any]:
        return {
            "received_at": self.received_at,
            "source": self.source,
            "decision": self.decision.name,
            "fingerprint_sha256": self.fingerprint_sha256,
            "issues": [asdict(i) for i in self.issues],
            "canonical_context": self.canonical_context,
        }


# =============================================================================
# Canonicalization (deterministic)
# =============================================================================

def _norm_str(s: str) -> str:
    if Config.NORMALIZE_UNICODE:
        s = unicodedata.normalize("NFKC", s)
    if Config.STRIP_STRINGS:
        s = s.strip()
    if Config.COLLAPSE_WHITESPACE:
        s = re.sub(r"\s+", " ", s)
    return s

def _is_json_primitive(x: Any) -> bool:
    return x is None or isinstance(x, (str, int, float, bool))

def _reject_non_finite_float(x: float) -> bool:
    return math.isnan(x) or math.isinf(x)

def canonicalize(value: Any, *, _path: str = "", _depth: int = 0, _state: Optional[Dict[str, int]] = None) -> Any:
    """
    Canonicalize recursively:
    - Normalize strings (unicode + whitespace)
    - Ensure dict keys are strings
    - Refuse NaN/Inf
    - Enforce depth/size limits deterministically
    """
    if _state is None:
        _state = {"nodes": 0}

    _state["nodes"] += 1
    if _state["nodes"] > Config.MAX_TOTAL_NODES:
        raise ValueError(f"Too many nodes in context (>{Config.MAX_TOTAL_NODES}) at {_path or '/'}")

    if _depth > Config.MAX_DEPTH:
        raise ValueError(f"Max depth exceeded (>{Config.MAX_DEPTH}) at {_path or '/'}")

    if value is None:
        return None

    if isinstance(value, bool):
        return value

    if isinstance(value, int):
        return value

    if isinstance(value, float):
        if _reject_non_finite_float(value):
            raise ValueError(f"Non-finite number at {_path or '/'}")
        # Keep floats as-is (deterministic), but you can choose to coerce to int if integerish
        return float(value)

    if isinstance(value, str):
        s = _norm_str(value)
        if len(s) > Config.MAX_STRING_LENGTH:
            raise ValueError(f"String too long at {_path or '/'} (>{Config.MAX_STRING_LENGTH})")
        return s

    if isinstance(value, list):
        if len(value) > Config.MAX_LIST_LENGTH:
            raise ValueError(f"List too long at {_path or '/'} (>{Config.MAX_LIST_LENGTH})")
        return [canonicalize(v, _path=f"{_path}/{i}", _depth=_depth + 1, _state=_state) for i, v in enumerate(value)]

    if isinstance(value, dict):
        if len(value) > Config.MAX_KEYS_PER_OBJECT:
            raise ValueError(f"Too many keys at {_path or '/'} (>{Config.MAX_KEYS_PER_OBJECT})")

        out: Dict[str, Any] = {}
        # Deterministic ordering: sort by canonical key
        items: List[Tuple[str, Any]] = []
        for k, v in value.items():
            if not isinstance(k, str):
                raise ValueError(f"Non-string key at {_path or '/'}: {repr(k)}")
            ck = _norm_str(k)
            items.append((ck, v))

        for ck, v in sorted(items, key=lambda t: t[0]):
            out[ck] = canonicalize(v, _path=f"{_path}/{ck}", _depth=_depth + 1, _state=_state)
        return out

    # Refuse unsupported types (datetime, set, bytes, etc.)
    raise ValueError(f"Unsupported type at {_path or '/'}: {type(value).__name__}")


# =============================================================================
# Schema validation (deterministic rules)
# =============================================================================

def _estimate_json_bytes(obj: Any) -> int:
    # Approx size guardrail (not exact, but deterministic enough)
    b = json.dumps(obj, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode("utf-8")
    return len(b)

def validate_schema(ctx: Dict[str, Any]) -> List[GateIssue]:
    """
    Default "CIG Envelope Schema" (tune this to your domain):

    Required top-level keys:
      - schema_version: int (>=1)
      - context_type: str (non-empty)
      - subject: dict with {id: str, kind: str}
      - attributes: dict

    Optional:
      - metadata: dict
      - claims: list
    """
    issues: List[GateIssue] = []

    def err(code: str, msg: str, path: str) -> None:
        issues.append(GateIssue(code=code, message=msg, path=path, severity="error"))

    def warn(code: str, msg: str, path: str) -> None:
        issues.append(GateIssue(code=code, message=msg, path=path, severity="warn"))

    # Size guardrail
    try:
        nbytes = _estimate_json_bytes(ctx)
        if nbytes > Config.MAX_BYTES_ESTIMATE:
            err("E_SIZE", f"Context too large (~{nbytes} bytes)", "/")
    except Exception:
        err("E_SIZE_ESTIMATE", "Failed to estimate payload size", "/")

    # Required fields
    if "schema_version" not in ctx:
        err("E_SCHEMA_VERSION_MISSING", "Missing schema_version", "/schema_version")
    else:
        sv = ctx.get("schema_version")
        if not isinstance(sv, int) or isinstance(sv, bool):
            err("E_SCHEMA_VERSION_TYPE", "schema_version must be int", "/schema_version")
        elif sv < 1:
            err("E_SCHEMA_VERSION_RANGE", "schema_version must be >= 1", "/schema_version")

    if "context_type" not in ctx:
        err("E_CONTEXT_TYPE_MISSING", "Missing context_type", "/context_type")
    else:
        ct = ctx.get("context_type")
        if not isinstance(ct, str) or not ct.strip():
            err("E_CONTEXT_TYPE_INVALID", "context_type must be non-empty string", "/context_type")

    if "subject" not in ctx:
        err("E_SUBJECT_MISSING", "Missing subject", "/subject")
    else:
        sub = ctx.get("subject")
        if not isinstance(sub, dict):
            err("E_SUBJECT_TYPE", "subject must be object", "/subject")
        else:
            sid = sub.get("id")
            sk = sub.get("kind")
            if not isinstance(sid, str) or not sid.strip():
                err("E_SUBJECT_ID", "subject.id must be non-empty string", "/subject/id")
            if not isinstance(sk, str) or not sk.strip():
                err("E_SUBJECT_KIND", "subject.kind must be non-empty string", "/subject/kind")

    if "attributes" not in ctx:
        err("E_ATTRIBUTES_MISSING", "Missing attributes", "/attributes")
    else:
        attrs = ctx.get("attributes")
        if not isinstance(attrs, dict):
            err("E_ATTRIBUTES_TYPE", "attributes must be object", "/attributes")

    # Optional sanity checks
    if "claims" in ctx and not isinstance(ctx["claims"], list):
        err("E_CLAIMS_TYPE", "claims must be array", "/claims")

    if "metadata" in ctx and not isinstance(ctx["metadata"], dict):
        err("E_METADATA_TYPE", "metadata must be object", "/metadata")

    # Unknown top-level keys: warn (not error)
    allowed = {"schema_version", "context_type", "subject", "attributes", "metadata", "claims"}
    for k in ctx.keys():
        if k not in allowed:
            warn("W_UNKNOWN_TOP_KEY", f"Unknown top-level key '{k}'", f"/{k}")

    return issues


# =============================================================================
# Policy enforcement (block/flag)
# =============================================================================

def _key_looks_secret(key: str) -> bool:
    k = key.lower()
    if k in Config.SECRET_KEY_NAME_HINTS:
        return True
    return any(p.search(key) for p in Config.SECRET_KEY_PATTERNS)

def _value_looks_secret(val: str) -> bool:
    return any(p.search(val) for p in Config.SECRET_VALUE_PATTERNS)

def policy_check(ctx: Dict[str, Any]) -> List[GateIssue]:
    issues: List[GateIssue] = []

    def err(code: str, msg: str, path: str) -> None:
        issues.append(GateIssue(code=code, message=msg, path=path, severity="error"))

    def warn(code: str, msg: str, path: str) -> None:
        issues.append(GateIssue(code=code, message=msg, path=path, severity="warn"))

    # Block by context_type
    ct = ctx.get("context_type")
    if isinstance(ct, str) and ct in Config.BLOCKED_CONTEXT_TYPES:
        err("E_BLOCKED_TYPE", f"context_type '{ct}' is blocked by policy", "/context_type")

    # Scan for secret-like keys/values (deterministic walk)
    def walk(x: Any, path: str) -> None:
        if isinstance(x, dict):
            for k in sorted(x.keys()):
                v = x[k]
                kp = f"{path}/{k}"
                if _key_looks_secret(k):
                    err("E_SECRET_KEY", f"Secret-like key '{k}' is not allowed", kp)
                walk(v, kp)
        elif isinstance(x, list):
            for i, v in enumerate(x):
                walk(v, f"{path}/{i}")
        elif isinstance(x, str):
            if _value_looks_secret(x):
                warn("W_SECRET_VALUE", "Value looks like a secret/token; review", path)

    walk(ctx, "")
    return issues


# =============================================================================
# Persistence (audit log)
# =============================================================================

class AuditStore:
    def __init__(self, filename: str = Config.AUDIT_FILE, logger_: logging.Logger = logger):
        self.filename = Path(filename)
        self.logger = logger_
        self.archive_dir = Path(Config.ARCHIVE_DIR)
        self.archive_dir.mkdir(parents=True, exist_ok=True)
        self.lock_path = self.filename.with_suffix(self.filename.suffix + ".lock")

    def _maybe_rotate(self) -> None:
        try:
            if self.filename.exists() and self.filename.stat().st_size > Config.MAX_AUDIT_FILE_SIZE:
                stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
                archive_name = self.archive_dir / f"{self.filename.stem}_{stamp}.jsonl"
                self.logger.info("Rotating audit file -> %s", archive_name)
                os.replace(self.filename, archive_name)
                _fsync_dir(self.archive_dir)
        except Exception as e:
            self.logger.exception("Failed rotating audit file: %s", e)

    def append_event(self, event: Dict[str, Any]) -> None:
        # JSONL append (atomic replace for whole file is expensive).
        # We lock + open in append mode, then fsync for durability.
        self.filename.parent.mkdir(parents=True, exist_ok=True)
        _assert_no_symlinks(self.filename)

        line = (json.dumps(event, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n").encode("utf-8")

        with FileLock(self.lock_path):
            self._maybe_rotate()
            # Ensure file isn't a symlink after rotate
            _assert_no_symlinks(self.filename)

            with open(self.filename, "ab") as f:
                f.write(line)
                f.flush()
                os.fsync(f.fileno())
            _fsync_dir(self.filename.parent)


# =============================================================================
# The Gate (the only entry point)
# =============================================================================

class ContextIntegrityGate:
    """
    The single entry-point gate.

    Pipeline (fixed order):
      1) Parse / intake
      2) Canonicalize
      3) Validate schema (deterministic)
      4) Policy checks
      5) Decide (ACCEPT / FLAG / REJECT)
      6) Persist audit
    """

    def __init__(self, audit_store: Optional[AuditStore] = None):
        self.audit = audit_store or AuditStore()

    def process(
        self,
        raw: Union[str, Dict[str, Any]],
        *,
        source: SourceType = SourceType.OTHER,
        received_at: Optional[str] = None,
        persist_audit: bool = True,
    ) -> GateResult:
        recv = received_at or _utc_now_iso()

        # 1) Intake parse
        ctx0, intake_issues = self._intake(raw)

        # If parse failed hard, reject immediately with minimal canonical context
        if ctx0 is None:
            result = GateResult(
                decision=Decision.REJECT,
                issues=tuple(intake_issues),
                canonical_context={},
                fingerprint_sha256=self._fingerprint({}),
                received_at=recv,
                source=source.name,
            )
            if persist_audit:
                self._safe_audit(result)
            return result

        # 2) Canonicalize (fail-fast)
        canonical_issues: List[GateIssue] = []
        try:
            ctx = canonicalize(ctx0)
            if not isinstance(ctx, dict):
                canonical_issues.append(GateIssue("E_TOPLEVEL", "Top-level must be object", "/", "error"))
                ctx = {}
        except Exception as e:
            canonical_issues.append(GateIssue("E_CANONICALIZE", str(e), "/", "error"))
            ctx = {}

        # 3) Schema validation
        schema_issues = validate_schema(ctx)

        # 4) Policy checks
        policy_issues = policy_check(ctx)

        all_issues = list(intake_issues) + canonical_issues + schema_issues + policy_issues

        # 5) Decide deterministically:
        # - Any "error" => REJECT
        # - Otherwise any "warn" => FLAG
        # - Else ACCEPT
        has_error = any(i.severity == "error" for i in all_issues)
        has_warn = any(i.severity == "warn" for i in all_issues)

        decision = Decision.REJECT if has_error else (Decision.FLAG if has_warn else Decision.ACCEPT)

        result = GateResult(
            decision=decision,
            issues=tuple(all_issues),
            canonical_context=ctx,
            fingerprint_sha256=self._fingerprint(ctx),
            received_at=recv,
            source=source.name,
        )

        # 6) Persist audit
        if persist_audit:
            self._safe_audit(result)

        return result

    def _safe_audit(self, result: GateResult) -> None:
        try:
            self.audit.append_event(result.to_audit_event())
        except Exception as e:
            logger.exception("Audit write failed: %s", e)

    def _fingerprint(self, ctx: Dict[str, Any]) -> str:
        dumped = json.dumps(ctx, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode("utf-8")
        return hashlib.sha256(dumped).hexdigest()

    def _intake(self, raw: Union[str, Dict[str, Any]]) -> Tuple[Optional[Dict[str, Any]], List[GateIssue]]:
        issues: List[GateIssue] = []

        def err(code: str, msg: str, path: str = "/") -> None:
            issues.append(GateIssue(code=code, message=msg, path=path, severity="error"))

        # Dict already
        if isinstance(raw, dict):
            return raw, issues

        if not isinstance(raw, str):
            err("E_INPUT_TYPE", "Input must be a dict, JSON string, or file path", "/")
            return None, issues

        s = raw.strip()
        if not s:
            err("E_EMPTY_INPUT", "Empty input", "/")
            return None, issues

        # If it's a path to an existing file, treat as file input
        p = Path(s)
        if p.exists() and p.is_file():
            try:
                _assert_no_symlinks(p)
                data = p.read_text(encoding="utf-8")
                obj = json.loads(data)
                if not isinstance(obj, dict):
                    err("E_FILE_JSON_TOPLEVEL", "JSON file must contain an object at top-level", "/")
                    return None, issues
                return obj, issues
            except json.JSONDecodeError as e:
                err("E_FILE_JSON_PARSE", f"Invalid JSON in file: {e}", "/")
                return None, issues
            except Exception as e:
                err("E_FILE_READ", f"Failed to read file: {e}", "/")
                return None, issues

        # Otherwise parse as JSON string
        try:
            obj = json.loads(s)
            if not isinstance(obj, dict):
                err("E_JSON_TOPLEVEL", "JSON input must be an object at top-level", "/")
                return None, issues
            return obj, issues
        except json.JSONDecodeError as e:
            err("E_JSON_PARSE", f"Invalid JSON input: {e}", "/")
            return None, issues


