def get_logger(name: str = "CIG") -> logging.Logger:
    logger = logging.getLogger(name)
    if logger.handlers:
        return logger

    logger.setLevel(logging.DEBUG)
    log_path = Path(Config.LOG_FILE)

    try:
        if log_path.exists() and log_path.is_symlink():
            raise OSError("Log path is symlinked")
        log_path.parent.mkdir(parents=True, exist_ok=True)
    except Exception:
        log_path = Path(".") / "cig.log"

    fh = logging.FileHandler(str(log_path), encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    ch = logging.StreamHandler()
    ch.setLevel(logging.INFO)

    fmt = logging.Formatter("%(asctime)s - %(name)s - %(levelname)s - %(message)s")
    fh.setFormatter(fmt)
    ch.setFormatter(fmt)

    logger.addHandler(fh)
    logger.addHandler(ch)
    return logger


logger = get_logger()


# =============================================================================
# File safety + atomic lock
# =============================================================================

def _now_ts() -> float:
    return time.time()

def _utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()

def _is_process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError as e:
        if e.errno in (errno.ESRCH, errno.EINVAL):
            return False
        if isinstance(e, PermissionError):
            return True
        return False
    else:
        return True

def _assert_no_symlinks(path: Path) -> None:
    p = Path(path)

    if p.exists() and p.is_symlink():
        raise OSError(f"Refusing to operate on symlinked file: {p}")

    for parent in p.parents:
        if parent.exists() and parent.is_symlink():
            raise OSError(f"Refusing to operate in symlinked directory: {parent}")

    # Best-effort: refuse if resolution differs (can indicate symlink traversal).
    try:
        if p.exists() or p.parent.exists():
            resolved = p.resolve()
            if p.exists() and str(resolved) != str(p.absolute()):
                raise OSError(f"Refusing path that resolves through symlinks: {p} -> {resolved}")
    except RuntimeError:
        raise OSError(f"Unsafe path resolution for {p}")

def _fsync_dir(path: Path) -> None:
    if sys.platform.startswith("win"):
        return
    try:
        fd = os.open(str(path), os.O_DIRECTORY)
    except Exception:
        return
    try:
        os.fsync(fd)
    except Exception:
        pass
    finally:
        try:
            os.close(fd)
        except Exception:
            pass

class FileLock:
    """
    Atomic lockfile containing:
      PID\\nTIMESTAMP\\n
    """
    def __init__(
        self,
        lock_path: Path,
        timeout: float = Config.LOCK_ACQUIRE_TIMEOUT,
        poll: float = Config.LOCK_POLL_INTERVAL,
        stale_seconds: float = Config.LOCK_STALE_SECONDS,
    ):
        self.lock_path = Path(lock_path)
        self.timeout = float(timeout)
        self.poll = float(poll)
        self.stale_seconds = float(stale_seconds)
        self._fd: Optional[int] = None

    def _write_lockfile(self, fd: int) -> None:
        content = f"{os.getpid()}\n{_now_ts()}\n"
        os.write(fd, content.encode("utf-8"))

    def _read_lockfile(self) -> Optional[Dict[str, Any]]:
        try:
            with open(self.lock_path, "r", encoding="utf-8") as f:
                lines = f.read().splitlines()
            if not lines:
                return None
            pid = int(lines[0].strip())
            ts = float(lines[1].strip()) if len(lines) > 1 else 0.0
            return {"pid": pid, "ts": ts}
        except Exception:
            return None

    def acquire(self) -> None:
        deadline = time.time() + self.timeout
        self.lock_path.parent.mkdir(parents=True, exist_ok=True)

        while True:
            try:
                fd = os.open(str(self.lock_path), os.O_WRONLY | os.O_CREAT | os.O_EXCL)
                self._write_lockfile(fd)
                self._fd = fd
                return
            except FileExistsError:
                info = self._read_lockfile()
                if info:
                    pid = info.get("pid", -1)
                    ts = float(info.get("ts", 0.0) or 0.0)
                    age = time.time() - ts
                    if (age >= self.stale_seconds) and (not _is_process_alive(int(pid))):
                        try:
                            os.unlink(self.lock_path)
                            logger.debug("Removed stale lock %s (pid=%s age=%.1fs)", self.lock_path, pid, age)
                            continue
                        except FileNotFoundError:
                            continue
                        except Exception as e:
                            logger.warning("Failed removing stale lock %s: %s", self.lock_path, e)
            except OSError as e:
                logger.error("OS error while creating lock %s: %s", self.lock_path, e)

            if time.time() > deadline:
                raise TimeoutError(f"Timeout while acquiring lock {self.lock_path}")
            time.sleep(self.poll)

    def release(self) -> None:
        try:
            if self._fd is not None:
                try:
                    os.close(self._fd)
                except Exception:
                    pass
            self._fd = None
            if self.lock_path.exists():
                try:
                    os.unlink(self.lock_path)
                except Exception as e:
                    logger.warning("Failed to remove lockfile %s: %s", self.lock_path, e)
        finally:
            self._fd = None

    def __enter__(self) -> "FileLock":
        self.acquire()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        self.release()

def _atomic_write_bytes_with_retries(
    target: Path,
    data_bytes: bytes,
    attempts: int = Config.WRITE_ATTEMPTS,
    base_wait: float = Config.WRITE_BASE_WAIT,
) -> None:
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    _assert_no_symlinks(target)

    tmp_name: Optional[str] = None
    for attempt in range(1, attempts + 1):
        try:
            with tempfile.NamedTemporaryFile("wb", delete=False, dir=str(target.parent)) as tf:
                tf.write(data_bytes)
                tf.flush()
                os.fsync(tf.fileno())
                tmp_name = tf.name

            os.replace(tmp_name, str(target))
            _fsync_dir(target.parent)
            return
        except Exception as e:
            logger.exception("Atomic write failed attempt %d/%d: %s", attempt, attempts, e)
            if tmp_name:
                try:
                    os.remove(tmp_name)
                except Exception:
                    pass
            if attempt == attempts:
                raise
            time.sleep(base_wait * (2 ** (attempt - 1)))


