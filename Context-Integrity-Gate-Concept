class TestCIG(unittest.TestCase):
    def test_canonicalize_strings(self):
        raw = {
            "schema_version": 1,
            "context_type": "profile",
            "subject": {"id": "u1", "kind": "user"},
            "attributes": {"name": "  John   Doe  "},
        }
        c = canonicalize(raw)
        self.assertEqual(c["attributes"]["name"], "John Doe")

    def test_reject_non_object_top_level(self):
        gate = ContextIntegrityGate(audit_store=AuditStore(filename=str(Path(tempfile.gettempdir()) / "cig_test.jsonl")))
        result = gate.process('["not","object"]', persist_audit=False)
        self.assertEqual(result.decision, Decision.REJECT)

    def test_schema_missing_reject(self):
        gate = ContextIntegrityGate(audit_store=AuditStore(filename=str(Path(tempfile.gettempdir()) / "cig_test.jsonl")))
        result = gate.process('{"context_type":"x"}', persist_audit=False)
        self.assertEqual(result.decision, Decision.REJECT)
        self.assertTrue(any(i.code == "E_SCHEMA_VERSION_MISSING" for i in result.issues))

    def test_policy_secret_key_reject(self):
        gate = ContextIntegrityGate(audit_store=AuditStore(filename=str(Path(tempfile.gettempdir()) / "cig_test.jsonl")))
        raw = {
            "schema_version": 1,
            "context_type": "profile",
            "subject": {"id": "u1", "kind": "user"},
            "attributes": {"password": "nope"},
        }
        result = gate.process(raw, persist_audit=False)
        self.assertEqual(result.decision, Decision.REJECT)
        self.assertTrue(any(i.code == "E_SECRET_KEY" for i in result.issues))

    def test_accept_clean(self):
        gate = ContextIntegrityGate(audit_store=AuditStore(filename=str(Path(tempfile.gettempdir()) / "cig_test.jsonl")))
        raw = {
            "schema_version": 1,
            "context_type": "profile",
            "subject": {"id": "u1", "kind": "user"},
            "attributes": {"name": "Jane"},
            "metadata": {"source_app": "demo"},
        }
        result = gate.process(raw, persist_audit=False)
        self.assertEqual(result.decision, Decision.ACCEPT)

    def test_flag_secret_like_value(self):
        gate = ContextIntegrityGate(audit_store=AuditStore(filename=str(Path(tempfile.gettempdir()) / "cig_test.jsonl")))
        raw = {
            "schema_version": 1,
            "context_type": "profile",
            "subject": {"id": "u1", "kind": "user"},
            "attributes": {"note": "sk-ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"},
        }
        result = gate.process(raw, persist_audit=False)
        # warn -> FLAG
        self.assertEqual(result.decision, Decision.FLAG)
        self.assertTrue(any(i.code == "W_SECRET_VALUE" for i in result.issues))


